# ── Copy this file to ".env" and fill in the values ──

# PostgreSQL connection string (you said you'll provide this).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/skillswap?schema=public"

# Port the API server listens on
PORT=4000

# Secret used to sign JWT login tokens — change to a long random string
JWT_SECRET="change-me-to-a-long-random-secret"

# How long a login token stays valid
JWT_EXPIRES_IN="7d"

# Which website is allowed to call this API (your frontend).
# Use * during local dev, or set it to your frontend URL.
CORS_ORIGIN="*"
